{
    "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  
    "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
    },
  
    "files": {
      "ignoreUnknown": true,
      "includes": ["**"],
      "excludes": ["node_modules", ".next", "dist", "build"]
    },
  
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100,
      "ignore": [
        "*.md"
      ]
    },
  
    "linter": {
      "enabled": true,
      "rules": {
        "recommended": true
      },
      "domains": {
        "react": "recommended",
        "next": "recommended"
      }
    },
  
    "assist": {
      "actions": {
        "source": {
          "organizeImports": "on"
        }
      }
    }
  }
  